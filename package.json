        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "images/flash_icon.png",
          "menuIcon": true
        }
      ]
    },
    "capabilities": [
      "configurable"
    ]
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
