{
  "name": "virta",
  "author": "Joakim Repomaa",
  "version": "1.3.3",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@moddable/pebbleproxy": "^0.1.8",
    "@rebble/clay": "^1.0.10"
  },
  "pebble": {
