{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "piu/MC": ["./types/piu/MC.d.ts"],
      "piu/MC-types": ["./types/piu/MC-types.d.ts"],
      "pebble/button": ["./types/pebble/button.d.ts"],
      "commodetto/Poco": ["./types/commodetto/Poco.d.ts"],
      "commodetto/PixelsOut": ["./types/commodetto/PixelsOut.d.ts"],
      "commodetto/Bitmap": ["./types/commodetto/Bitmap.d.ts"],
      "fetch": ["./types/web/fetch.d.ts"],
      "url": ["./types/web/url.d.ts"],
      "headers": ["./types/web/headers.d.ts"],
      "webstorage": ["./types/web/webstorage.d.ts"],
      "web/websocket": ["./types/web/websocket.d.ts"],
      "Resource": ["./types/Resource.d.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "src/embeddedjs/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
